{
  "name": "shiori",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "pnpm run /dev:/",
    "dev:web": "vite --port 4410 --strictPort",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/main.ts --port 4411 --dev",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts --port 4400 --static",
    "shiori": "node --disable-warning=ExperimentalWarning cli/shiori.ts",
    "check": "tsc --noEmit && biome check . && vitest run",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "motion": "^14.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.3",
    "mdast-util-directive": "^3.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
